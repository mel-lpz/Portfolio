---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---
<header class="bg-black text-white w-screen">
	<nav class="max-w-7xl mx-auto flex flex-wrap items-center justify-between px-6 py-4">
		<h2 class="text-xl font-bold">
			<a href="/Portfolio" class="hover:text-gray-400">{SITE_TITLE}</a>
		</h2>
		<div class="flex flex-wrap gap-4 text-sm font-medium">
			<HeaderLink href="/Portfolio">Home</HeaderLink>
			<HeaderLink href="/Portfolio/contact">Contact</HeaderLink>
			<HeaderLink href="/Portfolio/works">Works</HeaderLink>
		</div>
		<div class="flex gap-4 mt-4 md:mt-0">
			<a href="https://instagram.com" target="_blank" aria-label="Instagram" class="hover:text-gray-400">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
					<path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5.75-.75a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z"/>
				</svg>
			</a>
			<a href="https://youtube.com" target="_blank" aria-label="YouTube" class="hover:text-gray-400">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
					<path d="M19.615 3.184A4.198 4.198 0 0 0 16.875 2H7.125a4.198 4.198 0 0 0-2.74 1.184A4.136 4.136 0 0 0 3.25 5.875 43.73 43.73 0 0 0 3 12c0 2.035.09 4.022.25 6.125.09 1.06.541 2.023 1.385 2.691A4.198 4.198 0 0 0 7.125 22h9.75c.994 0 1.948-.35 2.74-1.184.844-.668 1.294-1.63 1.385-2.691.16-2.103.25-4.09.25-6.125 0-2.035-.09-4.022-.25-6.125a4.136 4.136 0 0 0-1.385-2.691zM10 15.5v-7l6 3.5-6 3.5z"/>
				</svg>
			</a>
			<a href="https://github.com/withastro/astro" target="_blank" aria-label="GitHub" class="hover:text-gray-400">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24" fill="currentColor">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

